[Unit]
Description=AR8 collector (节点心跳接收端点，部署在公网机)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/ar8-collector.py
Restart=always
RestartSec=3
# 监听端口与数据目录（用环境变量覆盖内置默认）
Environment=AR8_COLLECTOR_PORT=80
Environment=AR8_COLLECTOR_DIR=/var/lib/ar8-collector

[Install]
WantedBy=multi-user.target